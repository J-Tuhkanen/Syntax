# syntax=docker/dockerfile:1
#
# Build from the repository root (the API references ../core):
#   docker build -f backend/dockerfile -t syntax-api .

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG TARGETARCH
WORKDIR /source

# Project files first, so the restore layer is cached until dependencies change.
COPY backend/Syntax.API.csproj backend/
COPY core/Syntax.Core.csproj core/
RUN dotnet restore backend/Syntax.API.csproj -a $TARGETARCH

COPY backend/ backend/
COPY core/ core/
RUN dotnet publish backend/Syntax.API.csproj -c Release -a $TARGETARCH --no-restore -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
EXPOSE 8080
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "Syntax.API.dll"]
